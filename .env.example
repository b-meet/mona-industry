# Supabase project that stores submissions (enquiries, support messages, job
# applications) and CV uploads. Both values are public by design — they are
# inlined into the client bundle at build time.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Password for the /master panel.
#
# The site is a static export, so this is baked into the JS bundle at build
# time and anyone who reads the bundle can recover it. It keeps the screen out
# of casual reach; what actually protects the rows is the RLS policy in
# supabase/migrations/20260919_unified_submissions.sql. See section 4 of that
# file for locking reads to a signed-in admin instead.
NEXT_PUBLIC_MASTER_PASSWORD=change-me
