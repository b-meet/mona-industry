# ---------------------------------------------------------------------------
# Server-side only. No NEXT_PUBLIC_ prefix, so Next.js never inlines these into
# the browser bundle — the route handlers under app/api/ are the only things
# that read them, and the Supabase host never appears in a network request the
# visitor can see.
# ---------------------------------------------------------------------------

# Supabase → Project Settings → Data API → Project URL.
# The bare origin, with no /rest/v1 on the end.
SUPABASE_URL=https://your-project.supabase.co

# Supabase → Project Settings → API Keys → service_role (the secret one).
# It bypasses row level security. Never expose it to the browser and never
# commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Password for the /master panel. Checked server-side by
# POST /api/master/session, which sets an httpOnly cookie.
MASTER_PASSWORD=change-me

# Optional. Signs the /master session cookie. Falls back to MASTER_PASSWORD,
# which is fine — set it only if you want sessions to survive a password
# change. Any long random string works.
# MASTER_SESSION_SECRET=
