# ---------------------------------------------------------------------------
# Server-side only. No NEXT_PUBLIC_ prefix, so Next.js never inlines these into
# the browser bundle — the route handlers under app/api/ are the only things
# that read them, and the Supabase host never appears in a network request the
# visitor can see.
# ---------------------------------------------------------------------------

# Supabase → Project Settings → Data API → Project URL.
# The bare origin, with no /rest/v1 on the end.
SUPABASE_URL=https://your-project.supabase.co

# Supabase → Project Settings → API Keys → service_role (the secret one).
# It bypasses row level security. Never expose it to the browser and never
# commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Password for the /master panel. Checked server-side by
# POST /api/master/session, which sets an httpOnly cookie.
MASTER_PASSWORD=change-me

# Optional. Signs the /master session cookie. Falls back to MASTER_PASSWORD,
# which is fine — set it only if you want sessions to survive a password
# change. Any long random string works.
# MASTER_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Telegram alert for new submissions (enquiry, support, job application).
# Free at any volume. Leave these unset and the form still works — the
# submission is stored and only the alert is skipped.
# ---------------------------------------------------------------------------

# Open Telegram, message @BotFather, send /newbot and follow the prompts. It
# replies with a token that looks like the one below.
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenFromBotFather

# Where the alert is delivered. Send your new bot any message first (a bot
# cannot open a chat with you), then open
# https://api.telegram.org/bot<TELEGRAM_BOT_TOKEN>/getUpdates in a browser and
# copy result[0].message.chat.id. A group works too: add the bot to the group,
# post a message there, and use that chat id, which is negative.
TELEGRAM_CHAT_ID=123456789

# Optional. Adds a link to the /master panel at the end of each alert.
# SITE_URL=https://monaindustry.com
